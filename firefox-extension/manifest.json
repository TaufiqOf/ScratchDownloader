{
  "manifest_version": 2,
  "name": "ScratchDownloader Integration",
  "version": "1.0.0",
  "description": "Send download links to the ScratchDownloader desktop application.",
  "browser_specific_settings": {
    "gecko": { "id": "scratchdownloader@taufiqof.github.io" }
  },
  "permissions": ["downloads", "contextMenus", "storage", "notifications", "http://127.0.0.1:47653/*"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "ScratchDownloader", "default_popup": "popup.html" }
}

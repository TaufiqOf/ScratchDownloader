<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchDownload.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="ScratchDownload.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- TOOLBAR -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="2">

            <Button ToolTip.Tip="New"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding NewCommand}">
                <fluent:FluentIcon Icon="New" />
            </Button>

            <Border BorderThickness="1"
                    BorderBrush="Gray"
                    Margin="5,0" />

            <Button ToolTip.Tip="Resume"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ResumeCommand}">
                <fluent:FluentIcon Icon="DocumentArrowDown" />
            </Button>

            <Button ToolTip.Tip="Stop"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding StopCommand}">
                <StackPanel Orientation="Horizontal" >
                    <fluent:FluentIcon Icon="Stop" />
                </StackPanel>
            </Button>

            <Button ToolTip.Tip="Stop All"
                    Command="{Binding StopAllCommand}">
                <StackPanel Orientation="Horizontal" >
                    <fluent:FluentIcon Icon="RecordStop" />
                </StackPanel>
            </Button>

        </StackPanel>

        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="Gray"
                Margin="0,5,0,0" />

        <!-- DOWNLOAD DATA GRID -->
        <dg:DataGrid Grid.Row="2"
                     Margin="0,8"
                     ItemsSource="{Binding Downloads}"
                     SelectedItem="{Binding SelectedDownload}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserResizeColumns="True"
                     CanUserSortColumns="True"
                     GridLinesVisibility="Horizontal">

            <dg:DataGrid.Columns>

                <!-- FILE -->
                <dg:DataGridTextColumn Header="File"
                                       Binding="{Binding FileName}"
                                       Width="3*" />

                <!-- STATUS -->
                <dg:DataGridTextColumn Header="Status"
                                       Binding="{Binding Status}"
                                       Width="120" />

                <!-- PROGRESS -->
                <dg:DataGridTemplateColumn Header="Progress"
                                           Width="180">

                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Grid RowDefinitions="Auto,Auto"
                                  Margin="4">

                                <ProgressBar Grid.Row="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Progress}" />

                                <TextBlock Grid.Row="1"
                                           Text="{Binding ProgressText}"
                                           FontSize="11"
                                           Margin="0,3,0,0" />

                            </Grid>

                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>

                </dg:DataGridTemplateColumn>

                <!-- SPEED -->
                <dg:DataGridTextColumn Header="Speed"
                                       Binding="{Binding Speed}"
                                       Width="120" />

                <!-- SIZE -->
                <dg:DataGridTextColumn Header="Size"
                                       Binding="{Binding Size}"
                                       Width="110" />

                <!-- ETA -->
                <dg:DataGridTextColumn Header="ETA"
                                       Binding="{Binding Eta}"
                                       Width="100" />

            </dg:DataGrid.Columns>

        </dg:DataGrid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3"
                BorderThickness="0,1,0,0"
                BorderBrush="Gray"
                Padding="10,6">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="20">

                <TextBlock Grid.Column="0"
                           Text="{Binding DownloadSummary}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveCount}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding TotalSpeed}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding TotalDownloaded}" />

            </Grid>

        </Border>

    </Grid>

</UserControl>
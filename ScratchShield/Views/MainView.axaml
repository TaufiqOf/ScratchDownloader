<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScratchShield.ViewModels"
             xmlns:views="clr-namespace:ScratchShield.Views"
             xmlns:converter="clr-namespace:ScratchShield.Converter"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:Class="ScratchShield.Views.MainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>
    <UserControl.DataTemplates>

        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>

        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>

    </UserControl.DataTemplates>


    <SplitView IsPaneOpen="{Binding IsPaneOpen}"
               DisplayMode="CompactInline"
               OpenPaneLength="200"
               CompactPaneLength="55"
               PanePlacement="Left">

        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <SplitView.Pane>

            <Border>

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- HEADER -->

                    <StackPanel Grid.Row="0"
                                Margin="5,15,5,30"
                                Spacing="12">

                        <Button Command="{Binding TogglePaneCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Left">

                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="12">

                                <TextBlock Text="S"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Button>


                        <!-- Title -->
                        <StackPanel Spacing="2">

                            <TextBlock Text="ScratchShield"
                                       FontSize="20"
                                       IsVisible="{Binding IsPaneOpen}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="System Protection"
                                       FontSize="11"
                                       IsVisible="{Binding IsPaneOpen}"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- MENU -->

                    <StackPanel Grid.Row="1"
                                Margin="5"
                                Spacing="4">

                        <ToggleButton Command="{Binding ShowHomeCommand}"
                                      IsChecked="{Binding IsHomeSelected}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Padding="12">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="14">

                        <fluent:FluentIcon Icon="Home"
                                           Width="22"
                                           Height="22"
                                           FontSize="20"
                                          />

                                <TextBlock Text="Dashboard"
                                           FontSize="14"
                                           IsVisible="{Binding IsPaneOpen}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </ToggleButton>


                        <ToggleButton Command="{Binding ShowSettingsCommand}"
                                      IsChecked="{Binding IsSettingsSelected}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Padding="12">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="14">

                                <fluent:FluentIcon Icon="Settings"
                                           Width="22"
                                           Height="22"
                                           FontSize="20"
                                           />

                                <TextBlock Text="Settings"
                                           FontSize="14"
                                           IsVisible="{Binding IsPaneOpen}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </ToggleButton>

                    </StackPanel>


                    <!-- FOOTER -->

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding IsPaneOpen}"
                                Margin="16"
                                Spacing="2">

                        <TextBlock Text="ScratchShield"
                                   FontSize="10"/>

                        <TextBlock Text="v1.0.0"
                                   FontSize="10"/>

                    </StackPanel>

                </Grid>

            </Border>

        </SplitView.Pane>


        <!-- ========================= -->
        <!-- CONTENT -->
        <!-- ========================= -->

        <SplitView.Content>

            <Grid >

                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- TOP BAR -->

                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Margin="16,0">

                        <!-- MENU BUTTON -->

                        <Button Grid.Column="0"
                                Command="{Binding TogglePaneCommand}"
                                Width="44"
                                Height="44"
                                Background="Transparent"
                                BorderThickness="0">

                            <TextBlock Text="☰"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Button>


                        <!-- TITLE -->

                        <TextBlock Grid.Column="1"
                                   Text="ScratchShield"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsPaneOpen, Converter={StaticResource InverseBooleanConverter}}"
                                   Margin="12,0"/>

                    </Grid>

                </Border>


                <!-- PAGE -->

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

                    <ContentControl Margin="10" Content="{Binding CurrentView}"/>

                </ScrollViewer>

            </Grid>

        </SplitView.Content>

    </SplitView>

</UserControl>
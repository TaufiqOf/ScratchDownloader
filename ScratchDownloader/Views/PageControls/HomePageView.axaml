<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchDownloader.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:pageViewModel="clr-namespace:ScratchDownloader.ViewModels.PageViewModel"
             xmlns:models="clr-namespace:System.Collections;assembly=System.Collections.NonGeneric"
             xmlns:models1="clr-namespace:ScratchDownloader.Models"
             x:Class="ScratchDownloader.Views.PageControls.HomePageView"
             x:DataType="pageViewModel:HomePageViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- TOOLBAR -->
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    ToolTip.Tip="New"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="{DynamicResource AccentButtonBackground}"
                    Command="{Binding NewCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="AddCircle"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="New Download"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Grid.Column="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    Margin="5,5" />

            <Button Grid.Column="2"
                    ToolTip.Tip="Resume"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ResumeAllCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="Play"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="Resume All"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3"
                    ToolTip.Tip="Pause All"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PauseAllCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="Pause"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="Pause All"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Grid.Column="4"
                    ToolTip.Tip="Stop All"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding StopAllCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="Stop"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="Stop All"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Grid.Column="5"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    Margin="5,5" />

            <ComboBox Grid.Column="6"
                      ItemsSource="{Binding Categories}"
                      Width="200"
                      VerticalAlignment="Center"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models1:Category">
                        <Grid ColumnDefinitions="Auto,*">
                            <fluent:FluentIcon Icon="{Binding Icon}" VerticalAlignment="Center" />
                            <TextBlock Margin="5,0,0,0" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate> 
            </ComboBox>

            <ComboBox Grid.Column="6"
                      ItemsSource="{Binding Queues}"
                      Width="200"
                      Margin="205,0,0,0"
                      VerticalAlignment="Center"
                      SelectedItem="{Binding SelectedQueue, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models1:Queue">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Margin="5,0,0,0" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Grid.Column="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    Margin="5,5" />
            <!-- Search -->
            <TextBox Grid.Column="8"
                     Width="250"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     PlaceholderText="Search..."
                     Text="{Binding SearchText, Mode=TwoWay}" />
        </Grid>
        <Border Grid.Row="1"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Margin="0,5,0,0" />

        <!-- DOWNLOAD DATA GRID -->
        <dg:DataGrid Grid.Row="2"
                     Margin="0,8"
                     ItemsSource="{Binding FilteredDownloads}"
                     SelectedItem="{Binding SelectedDownload}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserResizeColumns="True"
                     CanUserSortColumns="True"
                     GridLinesVisibility="Horizontal">

            <dg:DataGrid.Columns>

                <!-- FILE -->
                <dg:DataGridTextColumn Header="File"
                                       Binding="{Binding DownloadItemInformation.FileName}"
                                       Width="3*" />

                <!-- STATUS -->
                <dg:DataGridTextColumn Header="Status"
                                       Binding="{Binding Status}"
                                       Width="120" />

                <!-- PROGRESS -->
                <dg:DataGridTemplateColumn Header="Progress"
                                           Width="250">

                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Grid RowDefinitions="Auto,Auto"
                                  Margin="4">

                                <ProgressBar Grid.Row="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Progress}" />

                                <TextBlock Grid.Row="1"
                                           Text="{Binding ProgressText}"
                                           FontSize="11"
                                           Margin="0,3,0,0" />

                            </Grid>

                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>

                </dg:DataGridTemplateColumn>

                <!-- SPEED -->
                <dg:DataGridTextColumn Header="Speed"
                                       Binding="{Binding Speed}"
                                       Width="120" />

                <!-- SIZE -->
                <dg:DataGridTextColumn Header="Size"
                                       Binding="{Binding DownloadItemInformation.FileSizeDisplay}"
                                       Width="110" />

                <!-- ETA -->
                <dg:DataGridTextColumn Header="ETA"
                                       Binding="{Binding Eta}"
                                       Width="100" />

            </dg:DataGrid.Columns>

        </dg:DataGrid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Margin="0,5,0,0">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="20">

                <TextBlock Grid.Column="0"
                           Text="{Binding DownloadManager.DownloadSummary}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding DownloadManager.ActiveCount}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding DownloadManager.TotalSpeed}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding DownloadManager.TotalDownloadedSize}" />

            </Grid>
        </Border>

    </Grid>

</UserControl>
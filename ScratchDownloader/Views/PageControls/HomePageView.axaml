<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchDownloader.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:pageViewModel="clr-namespace:ScratchDownloader.ViewModels.PageViewModel"
             x:Class="ScratchDownloader.Views.PageControls.HomePageView"
             x:DataType="pageViewModel:HomePageViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- TOOLBAR -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="2">

            <Button ToolTip.Tip="New"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Background="{DynamicResource AccentButtonBackground }"
                    Command="{Binding NewCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="AddCircle" VerticalAlignment="Center" />
                    <TextBlock Text="New Download" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    Margin="5,5" />

            <Button ToolTip.Tip="Resume"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ResumeAllCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="Play" VerticalAlignment="Center" />
                    <TextBlock Text="Resume All" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button ToolTip.Tip="Pause All"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding PauseAllCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="Pause" VerticalAlignment="Center" />
                    <TextBlock Text="Pause All" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button ToolTip.Tip="Stop All"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Command="{Binding StopAllCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fluent:FluentIcon Icon="Stop"
                                       VerticalAlignment="Center" />
                    <TextBlock Text="Stop All" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </StackPanel>

        <Border Grid.Row="1"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Margin="0,5,0,0" />

        <!-- DOWNLOAD DATA GRID -->
        <dg:DataGrid Grid.Row="2"
                     Margin="0,8"
                     ItemsSource="{Binding DownloadManager.Downloads}"
                     SelectedItem="{Binding SelectedDownload}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserResizeColumns="True"
                     CanUserSortColumns="True"
                     GridLinesVisibility="Horizontal">

            <dg:DataGrid.Columns>

                <!-- FILE -->
                <dg:DataGridTextColumn Header="File"
                                       Binding="{Binding DownloadItemInformation.FileName}"
                                       Width="3*" />

                <!-- STATUS -->
                <dg:DataGridTextColumn Header="Status"
                                       Binding="{Binding Status}"
                                       Width="120" />

                <!-- PROGRESS -->
                <dg:DataGridTemplateColumn Header="Progress"
                                           Width="250">

                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Grid RowDefinitions="Auto,Auto"
                                  Margin="4">

                                <ProgressBar Grid.Row="0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Progress}" />

                                <TextBlock Grid.Row="1"
                                           Text="{Binding ProgressText}"
                                           FontSize="11"
                                           Margin="0,3,0,0" />

                            </Grid>

                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>

                </dg:DataGridTemplateColumn>

                <!-- SPEED -->
                <dg:DataGridTextColumn Header="Speed"
                                       Binding="{Binding Speed}"
                                       Width="120" />

                <!-- SIZE -->
                <dg:DataGridTextColumn Header="Size"
                                       Binding="{Binding DownloadItemInformation.FileSizeDisplay}"
                                       Width="110" />

                <!-- ETA -->
                <dg:DataGridTextColumn Header="ETA"
                                       Binding="{Binding Eta}"
                                       Width="100" />

            </dg:DataGrid.Columns>

        </dg:DataGrid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3"
                BorderThickness="2"
                BorderBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Margin="0,5,0,0">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  ColumnSpacing="20">

                <TextBlock Grid.Column="0"
                           Text="{Binding DownloadManager.DownloadSummary}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding DownloadManager.ActiveCount}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding DownloadManager.TotalSpeed}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding DownloadManager.TotalDownloadedSize}" />

            </Grid>
        </Border>

    </Grid>

</UserControl>
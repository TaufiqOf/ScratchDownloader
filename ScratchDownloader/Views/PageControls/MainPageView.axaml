<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScratchDownloader.ViewModels"
             xmlns:views="clr-namespace:ScratchDownloader.Views"
             xmlns:converter="clr-namespace:ScratchDownloader.Converter"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:pageViewModel="clr-namespace:ScratchDownloader.ViewModels.PageViewModel"
             xmlns:pageControls="clr-namespace:ScratchDownloader.Views.PageControls"
             x:Class="ScratchDownloader.Views.PageControls.MainPageView"
             x:DataType="pageViewModel:MainPageViewModel">

    <UserControl.Resources>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converter:TypeMatchConverter x:Key="TypeMatchConverter" />
    </UserControl.Resources>
    <UserControl.DataTemplates>

        <DataTemplate DataType="pageViewModel:HomePageViewModel">
            <pageControls:HomePageView />
        </DataTemplate>
        
        <DataTemplate DataType="pageViewModel:CategoryPageViewModel">
            <pageControls:CategoryPageView />
        </DataTemplate>
        
        <DataTemplate DataType="pageViewModel:QueuePageViewModel">
            <pageControls:QueuePageView />
        </DataTemplate>

        <DataTemplate DataType="pageViewModel:SettingsPageViewModel">
            <pageControls:SettingsPageView />
        </DataTemplate>
    </UserControl.DataTemplates>


    <SplitView IsPaneOpen="{Binding IsPaneOpen}"
               DisplayMode="CompactInline"
               OpenPaneLength="200"
               CompactPaneLength="55"
               PanePlacement="Left">

        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <SplitView.Pane>

            <Border>

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- HEADER -->

                    <StackPanel Grid.Row="0"
                                Margin="5,15,5,30"
                                Spacing="12">

                        <Button Command="{Binding TogglePaneCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Left">

                            <Border Width="44"
                                    Height="44"
                                    CornerRadius="12">

                                <TextBlock Text="S"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                            </Border>

                        </Button>


                        <!-- Title -->
                        <StackPanel Spacing="2">

                            <TextBlock Text="ScratchDownloader"
                                       FontSize="20"
                                       IsVisible="{Binding IsPaneOpen}"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="System Protection"
                                       FontSize="11"
                                       IsVisible="{Binding IsPaneOpen}" />

                        </StackPanel>

                    </StackPanel>


                    <!-- MENU -->

                    <StackPanel Grid.Row="1"
                                Margin="5"
                                Spacing="4">

                        <!-- Home / Dashboard -->
                        <ToggleButton Command="{Binding ShowPageCommand}"
                                      CommandParameter="HomePageViewModel"
                                      IsChecked="{Binding CurrentView, Converter={StaticResource TypeMatchConverter}, ConverterParameter=HomePageViewModel, Mode=OneWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Padding="12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <fluent:FluentIcon Icon="Home" Width="22" Height="22" FontSize="20" />
                                <TextBlock Text="Dashboard" FontSize="14" IsVisible="{Binding IsPaneOpen}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- Category -->
                        <ToggleButton Command="{Binding ShowPageCommand}"
                                      CommandParameter="CategoryPageViewModel"
                                      IsChecked="{Binding CurrentView, Converter={StaticResource TypeMatchConverter}, ConverterParameter=CategoryPageViewModel, Mode=OneWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Padding="12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <fluent:FluentIcon Icon="Folder" Width="22" Height="22" FontSize="20" />
                                <TextBlock Text="Category" FontSize="14" IsVisible="{Binding IsPaneOpen}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <!-- Queue -->
                        <ToggleButton Command="{Binding ShowPageCommand}"
                                      CommandParameter="QueuePageViewModel"
                                      IsChecked="{Binding CurrentView, Converter={StaticResource TypeMatchConverter}, ConverterParameter=QueuePageViewModel, Mode=OneWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Padding="12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <fluent:FluentIcon Icon="DocumentQueue" Width="22" Height="22" FontSize="20" />
                                <TextBlock Text="Queue" FontSize="14" IsVisible="{Binding IsPaneOpen}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <!-- Settings -->
                        <ToggleButton Command="{Binding ShowPageCommand}"
                                      CommandParameter="SettingsPageViewModel"
                                      IsChecked="{Binding CurrentView, Converter={StaticResource TypeMatchConverter}, ConverterParameter=SettingsPageViewModel, Mode=OneWay}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      Padding="12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <fluent:FluentIcon Icon="Settings" Width="22" Height="22" FontSize="20" />
                                <TextBlock Text="Settings" FontSize="14" IsVisible="{Binding IsPaneOpen}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>


                    <!-- FOOTER -->

                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding IsPaneOpen}"
                                Margin="16"
                                Spacing="2">

                        <TextBlock Text="ScratchDownloader"
                                   FontSize="10" />

                        <TextBlock Text="v1.0.0"
                                   FontSize="10" />

                    </StackPanel>

                </Grid>

            </Border>

        </SplitView.Pane>


        <!-- ========================= -->
        <!-- CONTENT -->
        <!-- ========================= -->

        <SplitView.Content>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- PAGE -->

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

                    <ContentControl Margin="2" Content="{Binding CurrentView}" />

                </ScrollViewer>

            </Grid>

        </SplitView.Content>

    </SplitView>

</UserControl>
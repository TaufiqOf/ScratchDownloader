<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:dialogControlViewModel="clr-namespace:ScratchDownloader.ViewModels.DialogControlViewModel"
             xmlns:models="clr-namespace:ScratchDownloader.Models"
             Width="550"
             x:DataType="dialogControlViewModel:AddUrlDialogControlViewModel"
             x:Class="ScratchDownloader.Views.DialogControls.AddUrlDialogControl">
    <Grid RowDefinitions="*,Auto">
        <Border
            CornerRadius="5"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlBackgroundAltHighBrush}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <!-- ================= URL ================= -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="10">
                <StackPanel Grid.Row="0"
                            Spacing="6">

                    <TextBlock Text="URL"
                               FontSize="12" />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">

                        <TextBox Grid.Column="0"
                                 KeyDown="InputElement_OnKeyDown"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="https://..."
                                 VerticalContentAlignment="Center"
                                 Height="36" />

                        <Button Grid.Column="1"
                                Command="{Binding PasteCommand}"
                                Height="36"
                                MinWidth="86">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="7">

                                <fluent:FluentIcon Icon="Clipboard"
                                                   Width="16"
                                                   Height="16" />

                                <TextBlock Text="Paste"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </Grid>
                </StackPanel>


                <!-- ================= DETECTING ================= -->

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding IsDetecting}">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">

                        <Border Width="42"
                                Height="42"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource SystemAccentColorBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Left">

                            <TextBlock Text="•••"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Detecting file information..."
                                       FontSize="14" />

                            <TextBlock Text="Probing the link for filename and size."
                                       FontSize="12"
                                       Opacity="0.6" />

                        </StackPanel>

                    </Grid>
                </Border>


                <!-- ================= FILE INFORMATION ================= -->

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="10"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderThickness="1"
                        IsVisible="{Binding HasFileInfo}">

                    <Grid ColumnDefinitions="44,Auto,*"
                          ColumnSpacing="12">

                        <!-- File type -->
                        <Border Width="44"
                                Height="44"
                                CornerRadius="9"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                HorizontalAlignment="Left">

                            <TextBlock Text="{Binding DownloadItemInformation.FileExtension}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">


                            <TextBlock Text="{Binding DownloadItemInformation.FileName}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.6">
                                    <Run Text="{Binding DownloadItemInformation.FileHost}" />
                                    <Run> Size:</Run>
                                    <Run Text="{Binding DownloadItemInformation.FileSizeDisplay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </Border>


                <!-- ================= SAVE AS ================= -->

                <StackPanel Grid.Row="2"
                            Margin="0,12,0,0"
                            Spacing="6"
                            IsVisible="{Binding HasFileInfo}">

                    <TextBlock Text="SAVE AS"
                               FontSize="12"
                               Opacity="0.75" />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">

                        <TextBox Grid.Column="0"
                                 KeyDown="InputElement_OnKeyDown"
                                 Text="{Binding DownloadItemInformation.SavePath}"
                                 Height="36"
                                 TextAlignment="End"
                                 VerticalContentAlignment="Center" />

                        <Button Grid.Column="1"
                                Width="38"
                                Height="36"
                                Command="{Binding BrowseCommand}">

                            <fluent:FluentIcon Icon="FolderOpen"
                                               Width="17"
                                               Height="17" />

                        </Button>

                    </Grid>
                </StackPanel>


                <!-- ================= OPTIONS ================= -->

                <Grid Grid.Row="3"
                      Margin="0,12,0,0"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="12"
                      IsVisible="{Binding HasFileInfo}">

                    <!-- Category -->
                    <StackPanel Grid.Column="0"
                                Spacing="6">

                        <TextBlock Text="CATEGORY"
                                   FontSize="12"
                                   Opacity="0.75" />

                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding DownloadItemInformation.Category}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Category">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <fluent:FluentIcon Icon="{Binding Icon}" VerticalAlignment="Center" />
                                        <TextBlock Margin="5,0,0,0" Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>


                    <!-- Queue -->
                    <StackPanel Grid.Column="1"
                                Spacing="6">

                        <TextBlock Text="QUEUE"
                                   FontSize="12"
                                   Opacity="0.75" />

                        <ComboBox ItemsSource="{Binding Queues}"
                                  SelectedItem="{Binding DownloadItemInformation.Queue}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Queue">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Margin="5,0,0,0" Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>


                    <!-- Max Concurrent Downloads -->
                    <StackPanel Grid.Column="2"
                                Spacing="6">

                        <TextBlock Text="SEGMENTS"
                                   FontSize="12"
                                   Opacity="0.75" />

                        <ComboBox ItemsSource="{Binding SegmentOptions}"
                                  SelectedItem="{Binding DownloadItemInformation.Segments}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                </Grid>


                <!-- ================= ADVANCED ================= -->

                <Expander Grid.Row="4"
                          Margin="0,10,0,0"
                          Header="Advanced"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding HasFileInfo}">

                    <StackPanel Spacing="10"
                                Margin="5,8,5,5">
                        <TextBox PlaceholderText="Checksum" Text="{Binding DownloadItemInformation.Checksum}"></TextBox>

                        <CheckBox Content="Start download automatically"
                                  IsChecked="{Binding DownloadItemInformation.StartImmediately, Mode=TwoWay}" />

                    </StackPanel>

                </Expander>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="10">
                <Button Content="Cancel"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"

                        Command="{Binding NegativeCommand}"
                        MinWidth="75" />
                <Button
                    Command="{Binding StartDownloadCommand}"
                    MinWidth="75"
                    IsEnabled="{Binding HasFileInfo}"
                    IsDefault="True"
                    Background="{DynamicResource AccentButtonBackground}"
                    Margin="5,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <fluent:FluentIcon Icon="DocumentArrowDown"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Text="Download" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
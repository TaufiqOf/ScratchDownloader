<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScratchDownloader.Views.DialogControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogControlViewModel="clr-namespace:ScratchDownloader.ViewModels.DialogControlViewModel"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             x:DataType="dialogControlViewModel:MessageDialogControlViewModel"
             Width="400"
             x:Class="ScratchDownloader.Views.DialogControls.MessageDialogControl">
    <Grid RowDefinitions="*,Auto">
        <Border
            CornerRadius="5"
            BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlBackgroundAltHighBrush}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,*">
                <fluent:FluentIcon Icon="{Binding Icon}"
                                   VerticalAlignment="Top"
                                   FontSize="40"
                                   Width="40"
                                   Height="40"
                                   Margin="10" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Margin="10" />
            </Grid>
        </Border>
        <Border Grid.Row="1"
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel 
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="10">
                <Button Content="{Binding CancelButtonText}"
                        Command="{Binding CancelCommand}"
                        MinWidth="75"
                        IsVisible="{Binding IsCancelButtonVisible}" />
                <Button Content="{Binding OkButtonText}"
                        Command="{Binding OkCommand}"
                        MinWidth="75"
                        Margin="5,0,0,0" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>